{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbanplanningpros.com/schemas/operator-routing.schema.json",
  "title": "UPP Operator Routing Configuration",
  "type": "object",
  "required": ["version", "defaultProfile", "providers", "profiles", "circuitBreaker", "execution"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "defaultProfile": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["commandEnv", "enabled", "models"],
        "properties": {
          "commandEnv": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "models": {
            "type": "object",
            "required": ["primary", "fallbacks", "candidate"],
            "properties": {
              "primary": { "$ref": "#/$defs/modelRoute" },
              "fallbacks": {
                "type": "array",
                "items": { "$ref": "#/$defs/modelRoute" }
              },
              "candidate": {
                "anyOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/modelCandidate" }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["order"],
        "properties": {
          "order": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "canary": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["provider", "percent", "readOnly"],
                "properties": {
                  "provider": { "type": "string" },
                  "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "readOnly": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "circuitBreaker": {
      "type": "object",
      "required": ["failureThreshold", "cooldownSeconds", "halfOpenTestRequests"],
      "properties": {
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "cooldownSeconds": { "type": "integer", "minimum": 1 },
        "halfOpenTestRequests": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "timeoutSeconds",
        "readRetries",
        "writeRetries",
        "baseDelaySeconds",
        "jitter",
        "requireIdempotencyKeyForWrites",
        "persistBeforeExecution",
        "verifyAfterExecution"
      ],
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "readRetries": { "type": "integer", "minimum": 0 },
        "writeRetries": { "type": "integer", "minimum": 0 },
        "baseDelaySeconds": { "type": "number", "minimum": 0 },
        "jitter": { "type": "boolean" },
        "requireIdempotencyKeyForWrites": { "type": "boolean" },
        "persistBeforeExecution": { "type": "boolean" },
        "verifyAfterExecution": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "protectedPaths": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "requestPolicy": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "modelRoute": {
      "type": "object",
      "required": ["id", "requestPolicy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requestPolicy": { "$ref": "#/$defs/requestPolicy" }
      },
      "additionalProperties": false
    },
    "modelCandidate": {
      "type": "object",
      "required": ["id", "requestPolicy", "percent", "readOnly"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requestPolicy": { "$ref": "#/$defs/requestPolicy" },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "readOnly": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
