{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbanplanningpros.com/schemas/operator-task.schema.json",
  "title": "UPP Provider-Neutral Operator Task",
  "type": "object",
  "required": [
    "task_id",
    "operation_id",
    "objective",
    "acceptance_criteria",
    "risk",
    "write_intent",
    "handoff_safe",
    "allowed_paths",
    "prohibited_actions",
    "created_at"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 8 },
    "operation_id": { "type": "string", "minLength": 8 },
    "idempotency_key": { "type": ["string", "null"] },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk": { "enum": ["read_only", "low", "medium", "high", "irreversible"] },
    "write_intent": { "type": "boolean" },
    "handoff_safe": { "type": "boolean" },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "prohibited_actions": { "type": "array", "items": { "type": "string" } },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
