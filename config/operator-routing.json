{
  "$schema": "../schemas/operator-routing.schema.json",
  "version": 4,
  "defaultProfile": "openai_degraded",
  "providers": {
    "openai": {
      "commandEnv": "OPERATOR_OPENAI_COMMAND",
      "enabled": true,
      "models": {
        "primary": {
          "id": "gpt-5.5",
          "requestPolicy": {
            "multiAgent": "disabled",
            "quotaContainment": "single_agent"
          }
        },
        "fallbacks": [],
        "candidate": null
      }
    },
    "local": {
      "commandEnv": "OPERATOR_LOCAL_COMMAND",
      "enabled": true,
      "models": {
        "primary": {
          "id": "local-approved",
          "requestPolicy": {
            "network": "deny_by_default",
            "secrets": "none"
          }
        },
        "fallbacks": [],
        "candidate": null
      }
    }
  },
  "profiles": {
    "normal": {
      "order": ["openai", "local"],
      "canary": null
    },
    "continuity": {
      "order": ["openai", "local"],
      "canary": null
    },
    "openai_degraded": {
      "order": ["local", "openai"],
      "canary": {
        "provider": "openai",
        "percent": 10,
        "readOnly": true
      }
    },
    "local_degraded": {
      "order": ["openai", "local"],
      "canary": {
        "provider": "local",
        "percent": 10,
        "readOnly": true
      }
    }
  },
  "circuitBreaker": {
    "failureThreshold": 2,
    "cooldownSeconds": 900,
    "halfOpenTestRequests": 2
  },
  "execution": {
    "timeoutSeconds": 900,
    "readRetries": 3,
    "writeRetries": 0,
    "baseDelaySeconds": 2,
    "jitter": true,
    "requireIdempotencyKeyForWrites": true,
    "persistBeforeExecution": true,
    "verifyAfterExecution": true
  },
  "protectedPaths": [
    "AGENTS.md",
    ".cursorrules",
    ".github/workflows/**",
    ".git/hooks/**",
    ".devcontainer/**",
    ".vscode/**",
    "package.json",
    "bun.lock",
    "bun.lockb",
    "requirements*.txt",
    "pyproject.toml",
    "Dockerfile*",
    "**/.env*",
    "**/*secret*",
    "**/*credential*"
  ]
}
