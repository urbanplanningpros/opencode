{
  "$schema": "../schemas/operator-routing.schema.json",
  "version": 2,
  "defaultProfile": "continuity",
  "providers": {
    "openai": {
      "commandEnv": "OPERATOR_OPENAI_COMMAND",
      "enabled": true,
      "models": {
        "primary": {
          "id": "gpt-5.6-sol",
          "requestPolicy": {}
        },
        "fallbacks": [],
        "candidate": null
      }
    },
    "anthropic": {
      "commandEnv": "OPERATOR_ANTHROPIC_COMMAND",
      "enabled": true,
      "models": {
        "primary": {
          "id": "claude-opus-4-8",
          "requestPolicy": {
            "thinking": "provider_default",
            "serverSideFallback": "disabled"
          }
        },
        "fallbacks": [],
        "candidate": {
          "id": "claude-opus-5",
          "percent": 10,
          "readOnly": true,
          "requestPolicy": {
            "thinking": "adaptive_default",
            "disableThinkingMaxEffort": "high",
            "serverSideFallback": "disabled",
            "midConversationToolChanges": "disabled"
          }
        }
      }
    }
  },
  "profiles": {
    "normal": {
      "order": ["openai", "anthropic"],
      "canary": null
    },
    "continuity": {
      "order": ["anthropic", "openai"],
      "canary": {
        "provider": "openai",
        "percent": 10,
        "readOnly": true
      }
    },
    "openai_degraded": {
      "order": ["anthropic", "openai"],
      "canary": {
        "provider": "openai",
        "percent": 10,
        "readOnly": true
      }
    },
    "anthropic_degraded": {
      "order": ["openai", "anthropic"],
      "canary": {
        "provider": "anthropic",
        "percent": 10,
        "readOnly": true
      }
    }
  },
  "circuitBreaker": {
    "failureThreshold": 2,
    "cooldownSeconds": 300,
    "halfOpenTestRequests": 2
  },
  "execution": {
    "timeoutSeconds": 900,
    "readRetries": 3,
    "writeRetries": 0,
    "baseDelaySeconds": 2,
    "jitter": true,
    "requireIdempotencyKeyForWrites": true,
    "persistBeforeExecution": true,
    "verifyAfterExecution": true
  },
  "protectedPaths": [
    "AGENTS.md",
    "CLAUDE.md",
    ".cursorrules",
    ".github/workflows/**",
    ".git/hooks/**",
    ".devcontainer/**",
    ".vscode/**",
    "package.json",
    "bun.lock",
    "bun.lockb",
    "requirements*.txt",
    "pyproject.toml",
    "Dockerfile*",
    "**/.env*",
    "**/*secret*",
    "**/*credential*"
  ]
}
